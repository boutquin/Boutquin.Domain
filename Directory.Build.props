<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Authors>Pierre G. Boutquin</Authors>
    <Company>Boutquin Computer Consulting</Company>
    <PackageProjectUrl>https://github.com/boutquin/Boutquin.Domain</PackageProjectUrl>
    <RepositoryUrl>https://github.com/boutquin/Boutquin.Domain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Copyright>Copyright © 2019-2026, Boutquin Computer Consulting. All rights reserved.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <MinVerDefaultPreReleaseIdentifiers>beta</MinVerDefaultPreReleaseIdentifiers>

    <!-- Deterministic builds & SourceLink -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Shipping src/ enforces CS1591 (full public-API XML-doc coverage); non-shipping test/benchmark/example
       projects keep it deferred — tests do not ship documentation. CS1573 is enforced everywhere. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/tests/'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Lock each NuGet package's public contract. The analyzer discovers the two baseline
       files automatically; keeping them out of AdditionalFiles avoids duplicate inclusion. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

  <!-- MinVer 7 deliberately emits 0.0.0.0 for every pre-1.0 build. Boutquin packages
       instead bind within the current pre-1.0 minor line, where SemVer permits breaking
       changes, and return to major-line binding at 1.0. This must run after MinVer writes
       its values and before the SDK consumes AssemblyVersion. -->
  <Target Name="ApplyBoutquinAssemblyVersionPolicy"
          AfterTargets="MinVer"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(IsPackable)' == 'true'
                     and '$(MinVerSkip)' != 'true'
                     and '$(MinVerMajor)' != ''">
    <PropertyGroup>
      <AssemblyVersion Condition="'$(MinVerMajor)' == '0'">0.$(MinVerMinor).0.0</AssemblyVersion>
      <AssemblyVersion Condition="'$(MinVerMajor)' != '0'">$(MinVerMajor).0.0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <!-- NuGet's PackTask accepts a VersionRange in ProjectVersion metadata. Convert the
       versions collected from project references to exact ranges so the three packages
       always restore as one coherent candidate. PackageVerification guards this SDK hook. -->
  <Target Name="PinBoutquinProjectReferencePackageVersions"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(IsPackable)' == 'true'
                     and '@(_ProjectReferencesWithVersions)' != ''">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
